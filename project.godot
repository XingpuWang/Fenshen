; Shanhe Strategy — Godot 4.7
config_version=5

[application]
config/name="封神 · 九州经营"
config/use_custom_user_dir=true
config/custom_user_dir_name="godot/app_userdata/山河 · 九州行军"
config/custom_user_dir_name.macos="Godot/app_userdata/山河 · 九州行军"
config/custom_user_dir_name.windows="Godot/app_userdata/山河 · 九州行军"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/ui/app_icon.svg"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=2
environment/defaults/default_clear_color=Color(0.06,0.075,0.06,1)

[gui]
theme/default_font_multichannel_signed_distance_field=true
